{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CRL",
  "scopeName": "source.crl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#version" },
    { "include": "#objectLines" },
    { "include": "#declarations" },
    { "include": "#attributes" },
    { "include": "#predicates" },
    { "include": "#temporal" },
    { "include": "#signalKinds" },
    { "include": "#booleans" },
    { "include": "#durations" },
    { "include": "#timestamps" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.crl",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.crl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.crl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.crl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.crl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "version": {
      "patterns": [
        {
          "name": "meta.version.crl",
          "match": "^\\s*(crl)\\s+(v1|crl/v1)\\b",
          "captures": {
            "1": { "name": "keyword.control.version.crl" },
            "2": { "name": "constant.language.version.crl" }
          }
        }
      ]
    },
    "objectLines": {
      "patterns": [
        {
          "name": "meta.package.crl",
          "match": "^\\s*(package)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "keyword.declaration.package.crl" },
            "2": { "name": "entity.name.namespace.crl" }
          }
        },
        {
          "name": "meta.bundle.crl",
          "match": "^\\s*(bundle)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "keyword.declaration.bundle.crl" },
            "2": { "name": "entity.name.type.bundle.crl" }
          }
        },
        {
          "name": "meta.constructor.crl",
          "match": "^\\s*(constructor)\\s+([A-Za-z_][A-Za-z0-9_.-]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_.-]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.constructor.crl" },
            "2": { "name": "entity.name.type.constructor.crl" },
            "3": { "name": "storage.modifier.extends.crl" },
            "4": { "name": "entity.other.inherited-class.crl" }
          }
        },
        {
          "name": "meta.abstract-rule.crl",
          "match": "^\\s*(abstract)\\s+(rule)\\s+([A-Za-z_][A-Za-z0-9_.-]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_.-]*))?",
          "captures": {
            "1": { "name": "storage.modifier.abstract.crl" },
            "2": { "name": "keyword.declaration.rule.crl" },
            "3": { "name": "entity.name.type.rule.crl" },
            "4": { "name": "storage.modifier.extends.crl" },
            "5": { "name": "entity.other.inherited-class.crl" }
          }
        },
        {
          "name": "meta.rule.crl",
          "match": "^\\s*(rule)\\s+([A-Za-z_][A-Za-z0-9_.-]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_.-]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.rule.crl" },
            "2": { "name": "entity.name.type.rule.crl" },
            "3": { "name": "storage.modifier.extends.crl" },
            "4": { "name": "entity.other.inherited-class.crl" }
          }
        },
        {
          "name": "meta.cluster.crl",
          "match": "^\\s*(cluster)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "keyword.declaration.cluster.crl" },
            "2": { "name": "entity.name.type.cluster.crl" }
          }
        },
        {
          "name": "meta.target.crl",
          "match": "^\\s*(target)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "keyword.declaration.target.crl" },
            "2": { "name": "entity.name.tag.target.crl" }
          }
        },
        {
          "name": "meta.collector.crl",
          "match": "^\\s*(collector)\\s+([A-Za-z_][A-Za-z0-9_.-]*)\\s+([A-Za-z_][A-Za-z0-9_.-]*)\\s+([A-Za-z_][A-Za-z0-9_.-]*)\\s+(from)\\s+([^\\s#{}]+)(?:\\s+(schema)\\s+([A-Za-z_][A-Za-z0-9_.-]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.collector.crl" },
            "2": { "name": "entity.name.function.collector.crl" },
            "3": { "name": "support.type.provider.crl" },
            "4": { "name": "support.type.connector.crl" },
            "5": { "name": "keyword.other.from.crl" },
            "6": { "name": "string.unquoted.source.crl" },
            "7": { "name": "keyword.other.schema.crl" },
            "8": { "name": "entity.name.type.schema.crl" }
          }
        },
        {
          "name": "meta.signal.crl",
          "match": "^\\s*(signal)\\s+([A-Za-z_][A-Za-z0-9_.-]*)\\s+(number|bool|string|time)\\s+(from)\\s+([^\\s#{}]+)",
          "captures": {
            "1": { "name": "keyword.declaration.signal.crl" },
            "2": { "name": "variable.other.signal.crl" },
            "3": { "name": "storage.type.signal.crl" },
            "4": { "name": "keyword.other.from.crl" },
            "5": { "name": "string.unquoted.source-field.crl" }
          }
        },
        {
          "name": "meta.cluster-rules.crl",
          "match": "^\\s*(rules)\\s+(.+)$",
          "captures": {
            "1": { "name": "keyword.other.rules.crl" },
            "2": { "name": "entity.name.type.rule-reference.crl" }
          }
        },
        {
          "name": "meta.need.crl",
          "match": "^\\s*(need)\\s+([A-Za-z_][A-Za-z0-9_.-]*)\\s+(==|!=|>=|<=|>|<|before|after|within|age)\\b",
          "captures": {
            "1": { "name": "keyword.control.need.crl" },
            "2": { "name": "variable.other.proof-subject.crl" },
            "3": { "name": "keyword.operator.predicate.crl" }
          }
        },
        {
          "name": "meta.block.crl",
          "match": "^\\s*(block)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "keyword.control.block.crl" },
            "2": { "name": "variable.other.proof-subject.crl" }
          }
        },
        {
          "name": "meta.quorum.crl",
          "match": "^\\s*(quorum)\\s+(.+)$",
          "captures": {
            "1": { "name": "keyword.control.quorum.crl" },
            "2": { "name": "meta.expression.quorum.crl" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.crl",
          "match": "\\b(package|bundle|constructor|rule|cluster|target|collector|signal)\\b"
        },
        {
          "name": "keyword.declaration.abstract-rule.crl",
          "match": "\\babstract\\s+rule\\b"
        },
        {
          "name": "storage.modifier.extends.crl",
          "match": "\\bextends\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "keyword.other.attribute.crl",
          "match": "\\b(from|schema|unit|required|optional|ttl|expires|rules)\\b"
        }
      ]
    },
    "predicates": {
      "patterns": [
        {
          "name": "keyword.control.predicate.crl",
          "match": "\\b(need|block|quorum|count)\\b"
        }
      ]
    },
    "temporal": {
      "patterns": [
        {
          "name": "keyword.operator.temporal.crl",
          "match": "\\b(before|after|within|age|now)\\b"
        }
      ]
    },
    "signalKinds": {
      "patterns": [
        {
          "name": "storage.type.signal.crl",
          "match": "\\b(number|bool|string|time)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.crl",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.crl",
          "match": "\\b[0-9]+(ms|s|m|h|d|w|y)\\b"
        }
      ]
    },
    "timestamps": {
      "patterns": [
        {
          "name": "constant.other.timestamp.crl",
          "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.crl",
          "match": "\\b[-+]?[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.crl",
          "match": "==|!=|>=|<=|>|<|&&|\\|\\||&|\\||!|\\+|\\b(and|or|not|of)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.identifier.crl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b"
        }
      ]
    }
  }
}
