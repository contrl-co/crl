{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrl.co/schemas/crl/decision-trust-policy-v1.schema.json",
  "title": "CRL decision trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "created_at",
    "domain",
    "valid_from",
    "valid_until",
    "max_clock_skew_seconds",
    "roles",
    "keys",
    "allowed_extensions",
    "required_extensions",
    "policy_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "crl-decision-trust-policy/v1"
    },
    "policy_id": {
      "$ref": "#/$defs/uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "valid_from": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "#/$defs/timestamp"
    },
    "max_clock_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rolePolicy"
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/key"
      }
    },
    "allowed_extensions": {
      "$ref": "#/$defs/extensions"
    },
    "required_extensions": {
      "$ref": "#/$defs/extensions"
    },
    "policy_hash": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,62}/[a-z][a-z0-9._-]{0,63}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "extension": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,62}/[a-z][a-z0-9._-]{0,63}$"
    },
    "extensions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "rolePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "threshold",
        "max_signature_delay_seconds"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_signature_delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "role",
        "public_key",
        "not_before",
        "not_after"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "not_after": {
          "$ref": "#/$defs/timestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
